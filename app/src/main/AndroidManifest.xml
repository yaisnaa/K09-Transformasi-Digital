<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PB02: lokasi presisi dibutuhkan karena radius trigger hanya 25 m (lihat DECISIONS.md). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Google Maps mengunduh tile peta. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- PB05: foreground service lokasi + notifikasi POI (DECISIONS.md).
         ACCESS_BACKGROUND_LOCATION sengaja TIDAK dipakai. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PB06: narasi audio tetap berputar di latar (Media3). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HistoryGo">

        <!-- PB01: nilai diisi dari MAPS_API_KEY di local.properties lewat app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.HistoryGo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PB05: service pendeteksi POI. exported=false = hanya aplikasi ini yang boleh memulainya. -->
        <service
            android:name=".location.TriggerService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- PB06: service pemutar narasi. Intent-filter ini wajib agar kontrol media sistem
     (notifikasi, lock screen, headset Bluetooth) bisa terhubung. -->
        <service
            android:name=".audio.NarrationService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>


</manifest>